# development | production
APP_ENV=development

# Required in production; must match print-web JWT_SECRET
JWT_SECRET=

POSTGRES_DSN=postgresql+asyncpg://postgres:postgres@localhost:5432/print
# Log SQL statements to the API server console
POSTGRES_ECHO=false
POSTGRES_POOL_SIZE=5
POSTGRES_MAX_OVERFLOW=10

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
# Set true for Redis Cloud and other TLS endpoints
REDIS_SSL=false

# Frontend base URL for invite and password-reset links
WEB_APP_URL=http://localhost:3000

# CDN base URL for public S3 objects
ASSETS_CDN_URL=

# SMTP (optional in development — invite links are logged to stdout)
# Mailtrap sandbox: host sandbox.smtp.mailtrap.io, port 2525 or 587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@print.local
SMTP_USE_TLS=true
# Set false only in dev if a corporate proxy breaks TLS verification
SMTP_SSL_VERIFY=true
# Set true to print SMTP conversation in the API server console
SMTP_DEBUG=false

# Flutterwave v4 (Settings > API — Client ID, Client Secret, Encryption Key)
FLUTTERWAVE_CLIENT_ID=
FLUTTERWAVE_CLIENT_SECRET=
# Client-side card encryption (see developer.flutterwave.com/docs/encryption)
FLUTTERWAVE_ENCRYPTION_KEY=
# Webhook HMAC secret (Settings > Webhooks)
FLUTTERWAVE_WEBHOOK_SECRET=
# Optional override; defaults: sandbox developersandbox-api.flutterwave.com, live f4bexperience.flutterwave.com
# FLUTTERWAVE_API_BASE_URL=https://developersandbox-api.flutterwave.com

# Escrow: days after DELIVERED/PICKED_UP before seller payout release
ESCROW_RELEASE_DAYS=7
# Platform fee percentage retained on each paid order (seller gets remainder)
PLATFORM_FEE_PERCENT=5
