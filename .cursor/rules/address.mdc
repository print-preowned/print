---
alwaysApply: true
---
addresses:
  user_addresses:
    table: user_addresses
    owner: users.id
    access_context: CUSTOMER

    endpoints:
      GET /addresses:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      POST /addresses:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      GET /addresses/{id}:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      PATCH /addresses/{id}:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      DELETE /addresses/{id}:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      POST /addresses/{id}/set-default:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

    invariants:
      - id: MDC-BE-ADDRESS-1
        assertion: user_addresses_require_customer_context

      - id: MDC-BE-ADDRESS-2
        assertion: user_addresses_scoped_to_token_sub

      - id: MDC-BE-ADDRESS-3
        assertion: at_most_one_active_default_per_user

      - id: MDC-BE-ADDRESS-4
        assertion: delivery_phone_is_not_users_account_phone

  business_locations:
    table: business_addresses
    owner: businesses.id
    access_context: BUSINESS

    endpoints:
      GET /business-addresses:
        context: BUSINESS
        privilege: READ_BUSINESS
        enforce:
          - business_id == token.business.id

      POST /business-addresses:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

      GET /business-addresses/{id}:
        context: BUSINESS
        privilege: READ_BUSINESS
        enforce:
          - business_id == token.business.id

      PATCH /business-addresses/{id}:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

      DELETE /business-addresses/{id}:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

      POST /business-addresses/{id}/set-primary:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

    invariants:
      - id: MDC-BE-ADDRESS-5
        assertion: business_locations_require_business_context

      - id: MDC-BE-ADDRESS-6
        assertion: business_locations_scoped_to_token_business_id

      - id: MDC-BE-ADDRESS-7
        assertion: at_most_one_active_primary_per_business

      - id: MDC-BE-ADDRESS-8
        assertion: location_phone_is_distinct_from_user_account_phone

      - id: MDC-BE-ADDRESS-11
        assertion: at_most_one_pickup_enabled_per_business

    customer_pickup_read:
      GET /businesses/{businessId}/pickup-location:
        context: CUSTOMER
        returns: single pickup-enabled location or 404

  order_fulfillment:
    table: orders
    snapshot_columns:
      - fulfillment_type
      - recipient_name
      - address_label
      - phone_number
      - line1
      - line2
      - city
      - state
      - postal_code
      - country_code
    seller_columns:
      - business_id
      - business_name

    checkout:
      POST /orders:
        context: CUSTOMER
        request:
          fulfillment_type: DELIVERY | PICKUP
          shipping_address_id: required when fulfillment_type is DELIVERY
          pickup_location_id: required when fulfillment_type is PICKUP
        behavior:
          - validate_address_belongs_to_token_sub for DELIVERY
          - validate_pickup_location_belongs_to_cart_business and is sole pickup location for PICKUP
          - snapshot_fulfillment_columns_on_order_row
          - snapshot_business_name_from_businesses_name
          - derive_business_id_from_line_items
          - reject_mixed_business_carts

    status_paths:
      DELIVERY: PLACED -> CONFIRMED -> SHIPPED -> DELIVERED
      PICKUP: PLACED -> CONFIRMED -> READY_FOR_PICKUP -> PICKED_UP

    invariants:
      - id: MDC-BE-ADDRESS-9
        assertion: order_fulfillment_snapshot_is_immutable_after_create

      - id: MDC-BE-ADDRESS-10
        assertion: delivery_orders_require_valid_shipping_address_id

      - id: MDC-BE-ADDRESS-12
        assertion: pickup_orders_require_valid_pickup_location_id
