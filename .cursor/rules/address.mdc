---
alwaysApply: true
---
addresses:
  user_addresses:
    table: user_addresses
    owner: users.id
    access_context: CUSTOMER

    endpoints:
      GET /addresses:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      POST /addresses:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      GET /addresses/{id}:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      PATCH /addresses/{id}:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      DELETE /addresses/{id}:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

      POST /addresses/{id}/set-default:
        context: CUSTOMER
        enforce:
          - user_id == token.sub

    invariants:
      - id: MDC-BE-ADDRESS-1
        assertion: user_addresses_require_customer_context

      - id: MDC-BE-ADDRESS-2
        assertion: user_addresses_scoped_to_token_sub

      - id: MDC-BE-ADDRESS-3
        assertion: at_most_one_active_default_per_user

      - id: MDC-BE-ADDRESS-4
        assertion: delivery_phone_is_not_users_account_phone

  business_locations:
    table: business_addresses
    owner: businesses.id
    access_context: BUSINESS

    endpoints:
      GET /business-addresses:
        context: BUSINESS
        privilege: READ_BUSINESS
        enforce:
          - business_id == token.business.id

      POST /business-addresses:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

      GET /business-addresses/{id}:
        context: BUSINESS
        privilege: READ_BUSINESS
        enforce:
          - business_id == token.business.id

      PATCH /business-addresses/{id}:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

      DELETE /business-addresses/{id}:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

      POST /business-addresses/{id}/set-primary:
        context: BUSINESS
        privilege: UPDATE_BUSINESS
        enforce:
          - business_id == token.business.id

    invariants:
      - id: MDC-BE-ADDRESS-5
        assertion: business_locations_require_business_context

      - id: MDC-BE-ADDRESS-6
        assertion: business_locations_scoped_to_token_business_id

      - id: MDC-BE-ADDRESS-7
        assertion: at_most_one_active_primary_per_business

      - id: MDC-BE-ADDRESS-8
        assertion: location_phone_is_distinct_from_user_account_phone

  deferred:
    - order_shipping_address_snapshot
    - checkout_address_selection
